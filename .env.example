# Copy to .env and fill in what you need:  cp .env.example .env
#
# Every key is optional. Defaults live in config.py, and features whose
# credentials are missing report that clearly instead of failing silently.
# .env is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Agent LLM endpoint (any OpenAI-compatible server)
# ---------------------------------------------------------------------------
# The URL must end at "/v1". MODEL_NAME must be an id the server actually serves.
#   LM Studio  http://127.0.0.1:1234/v1
#   Ollama     http://127.0.0.1:11434/v1
#   vLLM       http://127.0.0.1:8000/v1
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
MODEL_NAME=qwen3.6-35b-a3b
TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Secondary remote endpoint — used by the benchmark's judge / chat simulator
# ---------------------------------------------------------------------------
# Only needed if you pass --judge-provider zen (or --agent/--simulator-provider zen).
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_ZEN_API_KEY=
ZEN_DEFAULT_MODEL=deepseek

# ---------------------------------------------------------------------------
# LibreLinkUp — live CGM sync (optional)
# ---------------------------------------------------------------------------
# Only for syncing readings from a real LibreLink account. Not used by the
# benchmark or any OhioT1DM workflow. Leave blank to disable live CGM.
LIBRE_EMAIL=
LIBRE_PASSWORD=
CGM_SYNC_ENABLED=true

# ---------------------------------------------------------------------------
# Optional third-party APIs
# ---------------------------------------------------------------------------
# Spoonacular: the benchmark reads a committed response cache, so food tasks run
# offline. A key is only needed for live nutrition lookups in the agent.
SPOONACULAR_API_KEY=
# Tavily: web search tool. Blank disables it.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Hardware metrics collection (analysis/collect_hw_metrics.py)
# ---------------------------------------------------------------------------
# Ollama host being measured, e.g. the edge device.
HW_METRICS_HOST=http://127.0.0.1:11434
